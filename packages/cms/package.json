{
	"name": "@repo/cms",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./services/label-service": "./src/services/label-service.ts",
		"./services/asset-service": "./src/services/asset-service.ts",
		"./generated/prismicio-types": "./src/generated/prismicio-types.d.ts",
