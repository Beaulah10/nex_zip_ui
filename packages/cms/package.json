		"next": "16.3.5",
		"react": "^19.2.0"
	},
	"devDependencies": {
		"@repo/typescript-config": "workspace:*",
		"@types/node": "^22.15.29",
		"@types/react": "^19.2.2",
		"typescript": "^5.9.3"
