{
	"name": "@repo/sdk",
	"version": "0.0.0",
	"type": "module",
	"exports": {
		".": "./index.ts",
		"./error": "./error/index.ts",
		"./swagger": "./swagger/index.ts",
		"./swagger.yaml": "./swagger.yaml"
	},
	"files": [
		"error",
		"index.ts",
		"request-auth.ts",
		"sdk-client.ts",
		"swagger",
		"swagger.yaml",
		"openapi-generator-config.json"
	],
	"scripts": {
		"sdk:clean": "node -e \"require('node:fs').rmSync('./swagger', { recursive: true, force: true })\"",
		"sdk:generate": "openapi-generator-cli generate -i ./swagger.yaml -g typescript-fetch -o ./swagger -c ./openapi-generator-config.json",
		"openapi:generate": "pnpm run sdk:generate",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@openapitools/openapi-generator-cli": "^2.39.0",
		"@repo/typescript-config": "workspace:*",
		"typescript": "^7.0.2"
	}
}
