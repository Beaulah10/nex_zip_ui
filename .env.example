# =============================================================
# SHARED MONOREPO ENV EXAMPLE
# Copy this file to .env and fill in the values.
#
#   cp .env.example .env
#
# NEVER commit .env — it is listed in .gitignore.
# Keep this file up-to-date when adding new variables.
# =============================================================


# ── Used by: ALL APPS ─────────────────────────────────────────

# Prismic repository slug (found in your Prismic dashboard URL)
PRISMIC_REPOSITORY_NAME=your-prismic-repo-name

# Prismic read-only API access token
# Dashboard → Settings → API & Security → Generate an access token
PRISMIC_ACCESS_TOKEN=your-prismic-access-token

# Prismic write / migration token (only needed for CMS migration scripts)
# Dashboard → Settings → API & Security → Migration API
PRISMIC_WRITE_TOKEN=your-prismic-write-token


# ── Used by: ibe-app, top-app ─────────────────────────────────

# Label source: "local" loads from /messages, "prismic" fetches from CMS
LABEL_SOURCE=prismic

# Prismic document type for IBE labels
IBE_PRISMIC_DOCUMENT_TYPE=ibe

# Prismic document type for top-app labels
TOP_PRISMIC_DOCUMENT_TYPE=top

# Enable detailed label flow logging for top-app
TOP_DEBUG_LABEL_FLOW=false

# Enable detailed label flow logging for ibe-app
IBE_DEBUG_LABEL_FLOW=false

# Enable SDK debug logging
SDK_DEBUG=false

# Frontend application URL
NEXT_PUBLIC_FRONTEND_URL=https://your-frontend-url.example.com

# Backend API base URL used by booking and related services
BACKEND_API_BASE_URL=https://your-api-gateway-url.amazonaws.com

NEXT_PUBLIC_ARKOSE_PUBLIC_KEY=your-arkose-public-key


# ── Used by: CMS migration scripts ────────────────────────────

# Shares the same repository settings above.